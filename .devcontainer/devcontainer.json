{
  "name": "BioTrace.Elsa.Abp",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "dev",
  "workspaceFolder": "/workspaces/BioTrace.Elsa.Abp",
  "remoteUser": "vscode",
  "forwardPorts": [44388, 44389],
  "portsAttributes": {
    "44388": { "label": "HttpApi.Host HTTPS", "onAutoForward": "notify" },
    "44389": { "label": "HttpApi.Host HTTP" }
  },
  "containerEnv": {
    "HTTP_PROXY": "http://host.docker.internal:7890",
    "HTTPS_PROXY": "http://host.docker.internal:7890",
    "http_proxy": "http://host.docker.internal:7890",
    "https_proxy": "http://host.docker.internal:7890",
    "NO_PROXY": "localhost,127.0.0.1,postgres,host.docker.internal",
    "no_proxy": "localhost,127.0.0.1,postgres,host.docker.internal"
  },
  "remoteEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development",
    "ConnectionStrings__Abp": "Host=postgres;Port=5432;Database=BioTrace_Abp;Username=postgres;Password=postgres",
    "ConnectionStrings__Elsa": "Host=postgres;Port=5432;Database=BioTrace_Elsa;Username=postgres;Password=postgres",
    "HTTP_PROXY": "http://host.docker.internal:7890",
    "HTTPS_PROXY": "http://host.docker.internal:7890",
    "http_proxy": "http://host.docker.internal:7890",
    "https_proxy": "http://host.docker.internal:7890",
    "NO_PROXY": "localhost,127.0.0.1,postgres,host.docker.internal",
    "no_proxy": "localhost,127.0.0.1,postgres,host.docker.internal"
  },
  "postCreateCommand": "dotnet dev-certs https && dotnet restore BioTrace.Elsa.Abp.slnx",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "dotnet.defaultSolution": "BioTrace.Elsa.Abp.slnx",
        "git.autorefresh": true,
        "git.refreshOnWindowFocus": true,
        "git.autofetch": false,
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/bin/**": true,
          "**/obj/**": true
        }
      }
    }
  }
}
