{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "check-all-dev-ports",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/check-dev-ports.sh all",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "check-host-ports",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/check-dev-ports.sh host",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "check-elsa-studio-ports",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/check-dev-ports.sh studio",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "wait-for-host",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/check-dev-ports.sh wait-host",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "prelaunch-host",
      "dependsOn": [
        "check-host-ports",
        "build-host"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "prelaunch-elsa-studio",
      "dependsOn": [
        "check-elsa-studio-ports",
        "wait-for-host",
        "build-elsa-studio"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "build-elsa-studio",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/host/BioTrace.Elsa.Abp.ElsaStudio/BioTrace.Elsa.Abp.ElsaStudio.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-host",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/host/BioTrace.Elsa.Abp.HttpApi.Host/BioTrace.Elsa.Abp.HttpApi.Host.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-solution",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/BioTrace.Elsa.Abp.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test-solution",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/BioTrace.Elsa.Abp.slnx",
        "--filter",
        "Category!=Integration",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test-integration",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/test-integration.sh",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ef-database-update-all-abp-contexts",
      "type": "shell",
      "command": "set -euo pipefail && dotnet ef database update --context AbpDbContext && dotnet ef database update --context IdentityDbContext && dotnet ef database update --context PermissionManagementDbContext && dotnet ef database update --context OpenIddictDbContext && dotnet ef database update --context TenantManagementDbContext",
      "options": {
        "cwd": "${workspaceFolder}/host/BioTrace.Elsa.Abp.HttpApi.Host"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
