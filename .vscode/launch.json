{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch HttpApi.Host (HTTPS)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-host",
      "program": "${workspaceFolder}/host/BioTrace.Elsa.Abp.HttpApi.Host/bin/Debug/net10.0/BioTrace.Elsa.Abp.HttpApi.Host.dll",
      "cwd": "${workspaceFolder}/host/BioTrace.Elsa.Abp.HttpApi.Host",
      "launchBrowser": {
        "enabled": true,
        "args": "${auto-detect-url}",
        "windows": {
          "command": "cmd.exe",
          "args": "/C start ${auto-detect-url}"
        }
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:44388;http://localhost:44389"
      }
    },
    {
      "name": "Attach to Process",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
