{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "efMigrationName",
      "type": "promptString",
      "description": "EF 迁移名称（如 Added_Book）",
      "default": "Migration"
    },
    {
      "id": "efDbContext",
      "type": "pickString",
      "description": "ABP DbContext",
      "options": [
        "AbpDbContext",
        "IdentityDbContext",
        "PermissionManagementDbContext",
        "OpenIddictDbContext",
        "TenantManagementDbContext"
      ],
      "default": "AbpDbContext"
    }
  ],
  "configurations": [
    {
      "name": "Launch HttpApi.Host (HTTPS)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prelaunch-host",
      "program": "${workspaceFolder}/host/BioTrace.Elsa.Abp.HttpApi.Host/bin/Debug/net10.0/BioTrace.Elsa.Abp.HttpApi.Host.dll",
      "cwd": "${workspaceFolder}/host/BioTrace.Elsa.Abp.HttpApi.Host",
      "launchBrowser": {
        "enabled": true,
        "args": "https://localhost:44388/studio",
        "windows": {
          "command": "cmd.exe",
          "args": "/C start https://localhost:44388/studio"
        }
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "https://localhost:44388/studio"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:44388;http://localhost:44389"
      }
    },
    {
      "name": "Attach to Process",
      "type": "coreclr",
      "request": "attach"
    },
    {
      "name": "EF: Database Update (All ABP Contexts)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "ef-database-update-all-abp-contexts",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "process.exit(0)"],
      "console": "internalConsole",
      "presentation": {
        "group": "database",
        "order": 1
      }
    }
  ]
}
