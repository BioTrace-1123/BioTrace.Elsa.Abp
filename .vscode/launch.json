{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "efMigrationName",
      "type": "promptString",
      "description": "EF 迁移名称（如 Added_Book）",
      "default": "Migration"
    },
    {
      "id": "efDbContext",
      "type": "pickString",
      "description": "ABP DbContext",
      "options": [
        "AbpDbContext",
        "IdentityDbContext",
        "PermissionManagementDbContext",
        "OpenIddictDbContext",
        "TenantManagementDbContext"
      ],
      "default": "AbpDbContext"
    }
  ],
  "configurations": [
    {
      "name": "Launch HttpApi.Host (HTTPS)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prelaunch-host",
      "program": "${workspaceFolder}/host/BioTrace.Elsa.Abp.HttpApi.Host/bin/Debug/net10.0/BioTrace.Elsa.Abp.HttpApi.Host.dll",
      "cwd": "${workspaceFolder}/host/BioTrace.Elsa.Abp.HttpApi.Host",
      "launchBrowser": {
        "enabled": true,
        "args": "${auto-detect-url}",
        "windows": {
          "command": "cmd.exe",
          "args": "/C start ${auto-detect-url}"
        }
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:44388;http://localhost:44389"
      },
      "presentation": {
        "group": "host+studio",
        "order": 1
      }
    },
    {
      "name": "Launch Elsa Studio (HTTPS)",
      "type": "blazorwasm",
      "request": "launch",
      "preLaunchTask": "prelaunch-elsa-studio",
      "cwd": "${workspaceFolder}/host/BioTrace.Elsa.Abp.ElsaStudio",
      "browser": "edge",
      "url": "https://localhost:5003",
      "webRoot": "${workspaceFolder}/host/BioTrace.Elsa.Abp.ElsaStudio/wwwroot",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5003;http://localhost:5004"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "presentation": {
        "group": "host+studio",
        "order": 2
      }
    },
    {
      "name": "Attach to Process",
      "type": "coreclr",
      "request": "attach"
    },
    {
      "name": "EF: Database Update (All ABP Contexts)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "ef-database-update-all-abp-contexts",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "process.exit(0)"],
      "console": "internalConsole",
      "presentation": {
        "group": "database",
        "order": 1
      }
    }
  ],
  "compounds": [
    {
      "name": "Host + Elsa Studio",
      "configurations": [
        "Launch HttpApi.Host (HTTPS)",
        "Launch Elsa Studio (HTTPS)"
      ],
      "preLaunchTask": "check-all-dev-ports",
      "stopAll": true,
      "presentation": {
        "group": "host+studio",
        "order": 0
      }
    }
  ]
}
