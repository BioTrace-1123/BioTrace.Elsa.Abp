@using Variant = MudBlazor.Variant
@inherits StudioComponentBase
@inject global::Elsa.Studio.Localization.ILocalizer Localizer

<MudDialog>
    <DialogContent>
        @if (!_canCreate)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                @Localizer["You do not have permission to create workflow definitions."]
            </MudAlert>
        }

        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit">
            <FluentValidationValidator @ref="_fluentValidationValidator" Validator="_validator" />
            <ValidationSummary />
            <MudTextField @bind-Value="_metadataModel.Name"
                          For="@(() => _metadataModel.Name)"
                          Label="@Localizer["Name"]"
                          Disabled="@(!_canCreate)"
                          Required="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
            <MudTextField @bind-Value="_metadataModel.Description"
                          For="@(() => _metadataModel.Description)"
                          Label="@Localizer["Description"]"
                          Disabled="@(!_canCreate)"
                          Lines="3"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClicked">@Localizer["Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(!_canCreate)"
                   OnClick="OnSubmitClicked">
            @Localizer["Ok"]
        </MudButton>
    </DialogActions>
</MudDialog>
