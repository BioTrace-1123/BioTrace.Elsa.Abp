<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BioTrace.Elsa.Abp.Studio</RootNamespace>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Elsa.Api.Client" Version="$(ElsaPackageVersion)" />
    <PackageReference Include="Elsa.Studio" Version="$(ElsaPackageVersion)" />
    <PackageReference Include="Elsa.Studio.Authentication.OpenIdConnect.BlazorWasm" Version="$(ElsaPackageVersion)" />
    <PackageReference Include="Elsa.Studio.Core.BlazorWasm" Version="$(ElsaPackageVersion)" />
    <PackageReference Include="Elsa.Studio.Localization.BlazorWasm" Version="$(ElsaPackageVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BioTrace.Elsa.Abp.Application.Contracts\BioTrace.Elsa.Abp.Application.Contracts.csproj" />
  </ItemGroup>

</Project>
