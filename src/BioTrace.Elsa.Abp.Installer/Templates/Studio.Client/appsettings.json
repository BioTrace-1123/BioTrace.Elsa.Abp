{
  "ElsaStudio": {
    "AbpApi": {
      "CurrentUserPath": "identity/users/me"
    },
    "Tenancy": {
      "UseAbpTenantApi": true,
      "Tenants": []
    },
    "Backend": {
      "Url": "{{BackendUrl}}"
    },
    "Authentication": {
      "Provider": "OpenIdConnect",
      "OpenIdConnect": {
        "Authority": "{{Authority}}",
        "ClientId": "ElsaStudio",
        "CallbackPath": "/studio/authentication/login-callback",
        "SignedOutCallbackPath": "/studio/authentication/logout-callback",
        "ResponseType": "code",
        "NameClaimType": "preferred_username",
        "RoleClaimType": "role",
        "AccountManagementUrl": "{{Authority}}/Account/Manage",
        "AuthenticationScopes": [
          "openid",
          "profile",
          "email",
          "roles",
          "{{ApiScope}}"
        ]
      }
    },
    "Localization": {
      "DefaultCulture": "en-US",
      "SupportedCultures": [
        "en-US"
      ]
    }
  }
}
