{
  "_comment": "合并到 Studio.Client/wwwroot/appsettings.json；Authority/ClientId 须与 Host OpenIddict 客户端一致",
  "ElsaStudio": {
    "Backend": {
      "Url": "https://localhost:44388/elsa/api"
    },
    "Authentication": {
      "Authority": "https://localhost:44388",
      "ClientId": "ElsaStudio",
      "ResponseType": "code",
      "DefaultScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "BioTrace_Elsa_Abp"
      ]
    },
    "Tenancy": {
      "UseAbpTenantApi": true,
      "Tenants": []
    }
  }
}
