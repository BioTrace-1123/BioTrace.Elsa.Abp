{
  "App": {
    "SelfUrl": "https://localhost:44388",
    "CorsOrigins": [
      "https://localhost:44388"
    ],
    "RedirectAllowedUrls": "https://localhost:44388"
  },
  "AuthServer": {
    "Authority": "https://localhost:44388",
    "SwaggerClientId": "MyApp_Swagger",
    "CertificatePath": "",
    "CertificatePassPhrase": ""
  },
  "ConnectionStrings": {
    "_comment": "连接串格式由宿主 ConfigureElsaPersistence 所选 EF Provider 决定（示例为 PostgreSQL）",
    "Default": "Host=localhost;Port=5432;Database=MyApp_Abp;Username=app_user;Password=change_me",
    "Elsa": "Host=localhost;Port=5432;Database=MyApp_Elsa;Username=elsa_user;Password=change_me"
  },
  "Elsa": {
    "RunMigrations": true,
    "EnableWorkflowsApi": true,
    "EnableElsaSwagger": false,
    "EnableHttpActivities": true,
    "EnablePermissionClaimsBridge": true,
    "DisableElsaEndpointSecurity": false,
    "PermissionsClaimType": "permissions",
    "RoleClaimType": "role"
  },
  "ElsaStudio": {
    "Enabled": true,
    "PathBase": "/studio"
  },
  "OpenIddict": {
    "Applications": {
      "MyApp_Swagger": {
        "ClientId": "MyApp_Swagger",
        "RootUrl": "https://localhost:44388"
      },
      "ElsaStudio": {
        "ClientId": "ElsaStudio",
        "RootUrl": "https://localhost:44388/studio",
        "RedirectUris": [
          "https://localhost:44388/studio/authentication/login-callback",
          "https://localhost:44388/studio/authentication/logout-callback"
        ],
        "PostLogoutRedirectUris": [
          "https://localhost:44388/studio/authentication/logout-callback"
        ]
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Elsa": "Information"
    }
  },
  "AllowedHosts": "*"
}
