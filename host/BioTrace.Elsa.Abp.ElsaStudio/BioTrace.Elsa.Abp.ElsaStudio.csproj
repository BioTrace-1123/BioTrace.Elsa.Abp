<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Elsa.Studio 启动时会切换 UI 文化；WASM 默认不加载全部全球化数据会抛 AggregateException -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <!--
    Elsa Server 锁定 3.5.3；Studio 前端使用 3.7.0（OpenIdConnect WASM 包自 3.7 起提供）。
    Api.Client 与 Workflows API 在演示环境中与 3.5.3 后端兼容。
  -->
  <ItemGroup>
    <PackageReference Include="Elsa.Api.Client" Version="3.7.0" />
    <PackageReference Include="Elsa.Studio" Version="3.7.0" />
    <PackageReference Include="Elsa.Studio.Authentication.OpenIdConnect.BlazorWasm" Version="3.7.0" />
    <PackageReference Include="Elsa.Studio.Core.BlazorWasm" Version="3.7.0" />
    <PackageReference Include="Elsa.Studio.Localization.BlazorWasm" Version="3.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
  </ItemGroup>

</Project>
