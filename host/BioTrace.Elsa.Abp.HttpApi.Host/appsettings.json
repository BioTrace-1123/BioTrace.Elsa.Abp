{
  "App": {
    "SelfUrl": "https://localhost:44388",
    "CorsOrigins": [
      "https://localhost:44388"
    ],
    "RedirectAllowedUrls": "https://localhost:44388"
  },
  "AuthServer": {
    "Authority": "https://localhost:44388",
    "SwaggerClientId": "BioTrace_Elsa_Abp_Swagger"
  },
  "Host": {
    "WaitForDatabase": true,
    "DatabaseWaitMaxAttempts": 30,
    "DatabaseWaitDelaySeconds": 2
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=BioTrace_Abp;Username=postgres;Password=postgres",
    "Elsa": "Host=localhost;Port=5432;Database=BioTrace_Elsa;Username=postgres;Password=postgres"
  },
  "MultiTenancy": {
    "IsEnabled": true
  },
  "Elsa": {
    "RunMigrations": true,
    "EnableMultiTenancy": true,
    "EnableWorkflowsApi": true,
    "EnableElsaSwagger": true,
    "EnableHttpActivities": true,
    "EnablePermissionClaimsBridge": true,
    "DisableElsaEndpointSecurity": false
  },
  "OpenIddict": {
    "Applications": {
      "BioTrace_Elsa_Abp_Swagger": {
        "ClientId": "BioTrace_Elsa_Abp_Swagger",
        "RootUrl": "https://localhost:44388"
      },
      "ElsaStudio": {
        "ClientId": "ElsaStudio",
        "RootUrl": "https://localhost:44388/studio",
        "RedirectUris": [
          "https://localhost:44388/studio/authentication/login-callback",
          "https://localhost:44388/studio/authentication/logout-callback"
        ],
        "PostLogoutRedirectUris": [
          "https://localhost:44388/studio/authentication/logout-callback"
        ]
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Elsa": "Information"
    }
  },
  "ElsaStudio": {
    "Enabled": true,
    "PathBase": "/studio"
  },
  "AllowedHosts": "*"
}
